# Copie este arquivo para .env antes de rodar `docker compose up`:
#   cp .env.example .env   (ou copie manualmente no Windows)
# O .env real nunca vai pro git (veja .gitignore) — cada pessoa/ambiente tem o seu.

# Credenciais do Postgres. São usadas de dois jeitos:
# 1) pelo serviço "db" no docker-compose.yml, pra criar o banco na primeira vez
# 2) pra montar a DATABASE_URL abaixo
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio

# String de conexão que o Prisma usa. Dentro da rede do docker compose, o
# host é "db" (o nome do serviço no docker-compose.yml), NÃO "localhost" —
# containers se enxergam pelo nome do serviço, não pela sua máquina.
DATABASE_URL=postgresql://portfolio:portfolio@db:5432/portfolio
