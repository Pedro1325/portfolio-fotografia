# Copie este arquivo para .env antes de rodar `docker compose up`. O .env
# real nunca vai pro git (veja .gitignore) — cada ambiente tem o seu.

# Credenciais do Postgres. Usadas pelo serviço "db" no docker-compose.yml
# pra criar o banco na primeira vez, e pra montar a DATABASE_URL abaixo.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio

# String de conexão que o Prisma usa. Dentro da rede do docker compose, o
# host é "db" (o nome do serviço no docker-compose.yml), NÃO "localhost" —
# containers se enxergam pelo nome do serviço, não pela sua máquina.
DATABASE_URL=postgresql://portfolio:portfolio@db:5432/portfolio

# Auth.js (NextAuth) — login. NEXTAUTH_SECRET assina os tokens de sessão;
# qualquer string longa e aleatória serve em dev. Pra gerar uma de verdade:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=troque-por-uma-string-aleatoria-longa-de-verdade
NEXTAUTH_URL=http://localhost:3000

# Única conta de admin do painel. Usadas só por `prisma/seed.ts` (rodado
# com `npm run db:seed`) pra criar essa conta no banco — não existe tela
# pública de cadastro. Troque por um e-mail e senha de verdade antes de
# rodar o seed; senha com pelo menos 8 caracteres.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
